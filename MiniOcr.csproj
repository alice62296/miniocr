<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MiniOcr</RootNamespace>
    <NoWarn>$(NoWarn);CA1416;IL2026;IL3050</NoWarn>

    <!-- Native AOT: IlcInstructionSet=avx2 is required for SimdPaddleOCR speed on x64 only.
         ARM64 must NOT set avx2 (uses NEON baseline). -->
    <PublishAot>true</PublishAot>
    <IlcInstructionSet Condition="$([System.String]::Copy('$(RuntimeIdentifier)').Contains('x64'))">avx2</IlcInstructionSet>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="1.4.1" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep model / Skia / PDFium assemblies from being trimmed away -->
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR" />
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" />
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR.Models.TextLineOrientation" />
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR.ModelProvider" />
    <TrimmerRootAssembly Include="PDFtoImage" />
    <TrimmerRootAssembly Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="samples/sample-multipage.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
